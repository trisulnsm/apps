.row.ui_form
  .col-12
    %form.form-dots
      .row
        .col-12
          .row
            %label.col-form-label.col-2 IPs
            .col-10
              %textarea{name:"searchipasn",rows:10}
              %span.form-help Paste any text; IPv4, IPv6, and CIDR subnets are extracted automatically.
      .row.justify-content-center
        .col-auto.align-self-center{style:"padding-top:10px"}
          %input.btn-submit{id:"btn_submit",name:"commit",type:"submit",value:"Search"}

.ui_data.pt-3
  .row
    .col-12.mt-3
      .card.border-primary
        .card-header.bg-primary.text-white
          %h5.card-title.text-light
            %i.fa.fa-table.fa-fw 
            Geo and BGP lookup   
            %small Showing country, ASN, prefix, AS path 
        .card-body#geo_bgp_lookup
          .animated-background
          .query_results
